{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SocialReader food_v1 card",
  "type": "object",
  "required": ["schema_version", "content_id", "platform", "source_url", "published_at", "food_items", "novelty", "hotness", "evidences", "errors"],
  "properties": {
    "schema_version": {"const": "food_v1"},
    "content_id": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "minLength": 1},
    "published_at": {"type": ["string", "null"]},
    "food_items": {"type": "array"},
    "evidences": {"type": "array"},
    "novelty": {
      "type": "object",
      "required": ["label", "evidence_ids", "rule_version"]
    },
    "hotness": {
      "type": "object",
      "required": ["label", "pool_size", "engagement_percentile", "metric_coverage", "rule_version"]
    },
    "errors": {"type": "array"}
  }
}
